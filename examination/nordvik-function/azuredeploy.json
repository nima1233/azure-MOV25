{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",

  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "nordvik",
      "metadata": {
        "description": "Base name used for the Azure resources."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": {
        "description": "Azure region where the resources will be created."
      }
    }
  },

  "variables": {
    "storageAccountName": "[concat('st', replace(parameters('name'), '-', ''), 'nimkam01')]"
  },

  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[concat('plan-', parameters('name'))]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": false
      },
      "tags": {
        "department": "ekonomi"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2"
      },
      "tags": {
        "department": "ekonomi"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/felanmalan')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/kontrakt')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/besiktning')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'kontrakt')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'besiktning')]"
      ],
      "properties": {
        "policy": {
          "rules": [
          {
            "name": "ArkiveraGamlaFiler",
            "enabled": true,
            "type": "Lifecycle",
            "definition": {
              "filters": {
                "blobTypes": [
                  "blockBlob"
                ],
                "prefixMatch": [
                  "kontrakt/",
                  "besiktning/"
                ]
              },
              "actions": {
                "baseBlob": {
                  "tierToCool": {
                    "daysAfterModificationGreaterThan": 90
                  }
                }
              }
            }
          }]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[concat('func-', parameters('name'))]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "tags": {
      "hidden-link:/app-insights-resource-id": "[resourceId('Microsoft.Insights/components', concat('appi-', parameters('name')))]",
      "department": "ekonomi"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', concat('plan-', parameters('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]",
        "[resourceId('Microsoft.Insights/components', concat('appi-', parameters('name')))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', concat('plan-', parameters('name')))]",
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', concat('appi-', parameters('name'))), '2020-02-02').ConnectionString]"
            },
            {
              "name": "APPLICATIONINSIGHTS_AUTHENTICATION_STRING",
              "value": "Authorization=AAD"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[concat('appi-', parameters('name'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan'), resourceId('Microsoft.Web/sites', concat('func-', parameters('name'))), 'Storage Blob Data Contributor')]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]",
      "dependsOn": [
      "[resourceId('Microsoft.Web/sites', concat('func-', parameters('name')))]",
      "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]"
      ],
      "properties": {
      "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
      "principalId": "[reference(resourceId('Microsoft.Web/sites', concat('func-', parameters('name'))), '2024-04-01', 'Full').identity.principalId]",
      "principalType": "ServicePrincipal"
      },
      "tags": {
        "department": "ekonomi"
      }
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2024-04-01",
      "name": "[concat('swa-', parameters('name'))]",
      "location": "eastasia",
      "sku": {
        "name": "Free"
      },
      "properties": {
        "stagingEnvironmentPolicy": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-09-01",
      "name": "[format('func-{0}/web', parameters('name'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', format('func-{0}', parameters('name')))]",
        "[resourceId('Microsoft.Web/staticSites', format('swa-{0}', parameters('name')))]"
      ],
        "properties": {
          "cors": {
            "allowedOrigins": [
              "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', format('swa-{0}', parameters('name'))), '2022-09-01').defaultHostname)]"
            ],
            "supportCredentials": false
          }
        },
        "tags": {
          "department": "ekonomi"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "azureblob-1",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "azureblob-1",
        "api": {
        "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azureblob')]"
        },
        "parameterValueSet": {
        "name": "managedIdentityAuth",
        "values": {}
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "sharepointonline",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "sharepointonline",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "office365",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "office365",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        }
      }
    },
      {
        "type": "Microsoft.Logic/workflows",
        "apiVersion": "2019-05-01",
        "name": "[concat('logic-', parameters('name'))]",
        "location": "[parameters('location')]",
        "identity": {
          "type": "SystemAssigned"
        },
        "dependsOn": [
          "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
          "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]",
          "[resourceId('Microsoft.Web/connections', 'azureblob-1')]",
          "[resourceId('Microsoft.Web/connections', 'sharepointonline')]",
          "[resourceId('Microsoft.Web/connections', 'office365')]"
        ],
        "properties": {
          "state": "Enabled",
          "definition": {
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "1.0.0.0",
            "parameters": {
              "$connections": {
                "defaultValue": {},
                "type": "Object"
              },
              "storageAccountName": {
                "defaultValue": "[variables('storageAccountName')]",
                "type": "String"
              }
            },
            "triggers": {
              "When_a_blob_is_added_or_changed": {
                "recurrence": {
                "interval": 3,
                "frequency": "Minute"
              },
              "splitOn": "@triggerBody()",
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureblob']['connectionId']"
                  }
                },
                "method": "get",
                "path": "[concat('/v2/datasets/@{encodeURIComponent(encodeURIComponent(''', variables('storageAccountName'), '''))}/triggers/batch/onupdatedfile')]",
                "queries": {
                  "folderId": "felanmalan",
                  "maxFileCount": 10,
                  "checkBothCreatedAndModifiedDateTime": false
                }
              },
              "conditions": [
                {
                  "expression": "@endsWith(triggerBody()?['Path'], '.json')"
                }
              ]
            }
          },
          "actions": {
            "Get_blob_content": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azureblob']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('storageAccountName')))}/files/@{encodeURIComponent(encodeURIComponent(triggerBody()?['Path']))}/content",
                "queries": {
                  "inferContentType": true
                }
              }
            },
            "Create_item": {
              "runAfter": {
                "Get_blob_content": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "Title": "@json(body('Get_blob_content'))?['title']",
                  "Kategori": {
                    "Value": "@json(body('Get_blob_content'))?['category']"
                  },
                  "Beskrivning": "@json(body('Get_blob_content'))?['description']"
                },
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent('https://coffeelatte1231outlook.sharepoint.com'))}/tables/@{encodeURIComponent(encodeURIComponent('c45d0dc5-a180-4aa9-b52b-0ff513edf152'))}/items"
              }
            },
            "Send_email": {
              "runAfter": {
                "Get_blob_content": ["Succeeded"]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "To": "forvaltare@coffeelatte1231outlook.onmicrosoft.com",
                  "Subject": "Nytt ärende",
                  "Body": "<p class=\"editor-paragraph\">Kolla igenom,<br><br>Rubrik: @{json(body('Get_blob_content'))?['title']}<br>Kategori: @{json(body('Get_blob_content'))?['category']}<br>Beskrivning : @{json(body('Get_blob_content'))?['description']}</p><br><p class=\"editor-paragraph\">ID: @{replace(replace(triggerBody()?['Name'], 'report-', ''), '.json', '')}</p>",
                  "Importance": "Normal"
                },
                "path": "/v2/Mail"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azureblob": {
                "id": "[concat(subscription().id, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azureblob')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', 'azureblob-1')]",
                "connectionName": "azureblob-1",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                },
                "storageAccountName": {
                  "value": "[variables('storageAccountName')]"
                }
              },
              "sharepointonline": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'sharepointonline')]",
                "connectionName": "sharepointonline",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
              },
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'office365')]",
                "connectionName": "office365",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
              }
            }
          }
        }
      },
      "tags": {
        "department": "ekonomi"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan'), resourceId('Microsoft.Logic/workflows', concat('logic-', parameters('name'))), 'Storage Blob Data Reader')]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', concat('logic-', parameters('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'felanmalan')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', concat('logic-', parameters('name'))), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],

  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    }
  }
}